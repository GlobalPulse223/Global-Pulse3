rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return request.auth.token.email_verified == true; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    match /articles/{articleId} {
      allow read: if true;
      allow create, delete: if true;
    }

    match /articles/{articleId}/comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && isVerified() && isValidId(articleId);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, update: if isSignedIn() && userId == request.auth.uid;
    }

    match /alerts/{alertId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
